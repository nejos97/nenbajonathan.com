---
import type { Project } from "../types";

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, image, imageAlt, website, github, tags } = project;

// The card title links to the website when there is one, to the repo otherwise.
const titleHref = website ?? github;
---

<li class="project-card">
  {
    image && (
      <a
        href={titleHref}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden={titleHref ? "true" : undefined}
        class="project-image-wrapper"
      >
        <img
          src={image}
          alt={imageAlt ?? title}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }

  <div class="project-body">
    <h2>
      {
        titleHref ? (
          <a href={titleHref} target="_blank" rel="noopener noreferrer">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h2>

    <p>{description}</p>

    {
      tags.length > 0 && (
        <ul class="project-tags" aria-label={`Technologies used for ${title}`}>
          {tags.map(tag => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="project-links">
      {
        website && (
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="group"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm7.931 9h-2.764a14.67 14.67 0 0 0-1.792-6.243A8.013 8.013 0 0 1 19.931 11zM12.53 4.027c1.035 1.364 2.427 3.78 2.627 6.973H9.03c.139-2.596.994-5.028 2.451-6.974.172-.01.344-.026.519-.026.179 0 .354.016.53.027zm-3.842.7C7.704 6.618 7.136 8.762 7.03 11H4.069a8.013 8.013 0 0 1 4.619-6.273zM4.069 13h2.974c.136 2.379.665 4.478 1.556 6.23A8.01 8.01 0 0 1 4.069 13zm7.381 6.973C10.049 18.275 9.222 15.896 9.041 13h6.113c-.208 2.773-1.117 5.196-2.603 6.972-.182.012-.364.028-.551.028-.186 0-.367-.016-.55-.027zm4.011-.772c.955-1.794 1.538-3.901 1.691-6.201h2.778a8.005 8.005 0 0 1-4.469 6.201z" />
            </svg>
            <span>Website</span>
          </a>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="group"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.523 2 12 2z" />
            </svg>
            <span>Source code</span>
          </a>
        )
      }
    </div>
  </div>
</li>

<style>
  .project-card {
    @apply flex flex-col overflow-hidden rounded-lg border border-skin-line bg-skin-card/20;
  }
  .project-image-wrapper {
    @apply block border-b border-skin-line bg-skin-card/40;
  }
  .project-image-wrapper img {
    @apply aspect-video w-full object-cover;
  }
  .project-body {
    @apply flex flex-1 flex-col gap-3 p-4;
  }
  .project-body h2 {
    @apply text-lg font-semibold decoration-dashed;
  }
  .project-body h2 a {
    @apply underline decoration-dashed underline-offset-4 hover:text-skin-accent;
  }
  .project-body p {
    @apply text-sm opacity-90;
  }
  .project-tags {
    @apply mt-auto flex flex-wrap gap-2;
  }
  .project-tags li {
    @apply rounded-full border border-skin-line bg-skin-card/60 px-2.5 py-0.5 text-xs;
  }
  .project-links {
    @apply flex flex-wrap items-center gap-x-5 gap-y-2 pt-1 text-sm;
  }
  .project-links a {
    @apply inline-flex items-center gap-1.5 underline decoration-dashed underline-offset-4 hover:text-skin-accent;
  }
  .project-links svg {
    @apply h-4 w-4 fill-skin-base group-hover:fill-skin-accent;
  }
</style>
